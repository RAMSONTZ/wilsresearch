# Add these to Vercel Project Settings > Environment Variables. Never prefix secrets NEXT_PUBLIC_ .
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require
# Random, long string e.g. openssl rand -hex 32. Also used to hash client IPs for throttling.
APP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Private admin entry, not linked publicly. Admin URL: https://yourdomain/office/YOUR_VALUE/
ADMIN_PATH_SEGMENT=REPLACE_WITH_LONG_RANDOM_ADMIN_PATH
# One-time local admin initialization; run npm run init:admin then remove these values.
WILS_ADMIN_EMAIL=
WILS_ADMIN_INITIAL_PASSWORD=
# Automated email from your verified sender domain (optional until domain is verified).
RESEND_API_KEY=
RESEND_FROM=bookings@your-verified-domain.com
ADMIN_NOTIFICATION_EMAIL=wilsresearch7@gmail.com
# Optional, officially registered WhatsApp Business Cloud API (not personal WhatsApp).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ADMIN_NUMBER=255786609975
META_WHATSAPP_TEMPLATE_NAME=wils_booking_received
META_WHATSAPP_TEMPLATE_LANGUAGE=en
